---
interface Props {title:string;description:string;canonicalPath:string;}
const {title,description,canonicalPath}=Astro.props;
const site=Astro.site??new URL('https://jsonl-studio.example.org/');
const canonical=new URL(canonicalPath,site).toString();
const placeholder=/(?:^|\.)example\.(?:org|com|net)$/.test(site.hostname);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="color-scheme" content="dark"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  {placeholder&&<meta name="robots" content="noindex,follow"/>}
  <link rel="stylesheet" href="/assets/style.css"/>
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <header class="top"><div class="shell nav">
    <a class="brand" href="/"><span class="logo" aria-hidden="true">S</span><strong>Sense<span class="dim"> / Lab</span></strong></a>
    <nav aria-label="Primary"><a href="/">Home</a><a href="/tools/jsonl-validator/">JSONL Validator</a></nav>
    <span class="privacy-chip">LOCAL PROCESSING</span>
  </div></header>
  <slot/>
  <footer class="footer"><div class="shell foot"><strong>Sense JSONL Lab</strong><span>Static Astro example · No backend · No user tracking</span></div></footer>
</body>
</html>
