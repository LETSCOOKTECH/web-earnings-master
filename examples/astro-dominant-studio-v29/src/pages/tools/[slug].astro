---
import BaseLayout from '../../layouts/BaseLayout.astro';
import tools from '../../data/tools.json';
export function getStaticPaths(){return tools.map(tool=>({params:{slug:tool.id},props:{tool}}));}
const {tool}=Astro.props;
const related=tools.filter(t=>t.id!==tool.id&&t.group===tool.group).slice(0,8);
const schema={"@context":"https://schema.org","@type":"WebApplication","name":tool.label,"applicationCategory":"DeveloperApplication","operatingSystem":"Web","description":tool.description};
const accepted={csv:'.csv,.csv.gz,text/csv',tsv:'.tsv,.tsv.gz',jsonl:'.jsonl,.jsonl.gz',json:'.json,application/json'}[tool.kind];
const sample=tool.kind==='csv'?'id,name\n00501,Asha\n00502,Lee\n':tool.kind==='tsv'?'id\tname\n00501\tAsha\n00502\tLee\n':tool.kind==='jsonl'?'{"id":"00501","name":"Asha"}\n{"id":"00502","name":"Lee"}\n':'[{"id":"00501","name":"Asha"},{"id":"00502","name":"Lee"}]';
---
<BaseLayout title={tool.label+' | Sense Data Studio'} description={tool.description+' Browser-local execution, real downloadable output and explicit limitations.'} canonicalPath={'/tools/'+tool.id+'/'}>
 <main class="wrap" id="main">
  <a class="back" href={'/hubs/'+tool.group+'/'}>{tool.group.toUpperCase()} tools</a>
  <p class="eyebrow">LOCAL WORKSPACE / {tool.kind.toUpperCase()}</p>
  <h1>{tool.label}</h1>
  <p class="intro">Use {tool.label.toLowerCase()} to process a local file or pasted text without uploading it. The engine returns deterministic output or an explicit format error; it does not silently transform IDs into numbers. Maximum decoded input is 16 MiB.</p>
  <section class="workspace" data-studio-route={tool.id} aria-label="Transformation workspace">
   <form id="studio-form" class="panel">
    <h2>Source data</h2>
    <label for="studio-file">Choose a {tool.kind.toUpperCase()} file</label>
    <input id="studio-file" type="file" accept={accepted} />
    <label for="studio-input">Or paste your data</label>
    <textarea id="studio-input" spellcheck="false" rows="11" placeholder="Paste file contents here"></textarea>
    <div class="options"><label><input type="checkbox" id="studio-escape" checked/> Protect CSV/TSV spreadsheet formulas</label>
    <label><input type="checkbox" id="studio-mask"/> Mask likely secrets in output</label></div>
    <div class="buttons"><button class="primary" type="submit" id="studio-run">Convert locally</button><button type="button" id="studio-sample">Load example</button><button type="button" id="studio-reset">Clear</button></div>
   </form>
   <div class="panel panel-out">
    <h2>Result</h2>
    <p id="studio-status" role="status" aria-live="polite">Ready. No file has been processed.</p>
    <pre class="preview" id="studio-preview" tabindex="0">Output preview will appear here.</pre>
    <div class="buttons"><a hidden id="studio-download" class="primary" download>Download result</a><button type="button" id="studio-copy" disabled>Copy result</button></div>
    <p class="hint" id="studio-receipt">No remote processing. Output available after conversion.</p>
    <button type="button" id="studio-chain" hidden>Continue in a compatible local tool</button>
    <button type="button" id="studio-clear-workflows">Delete saved local handoffs</button>
    <p class="hint">Optional: explicit consent can save up to 2 MiB of output in this browser's IndexedDB for a one-time handoff. It expires logically after 30 minutes and is deleted on use. Never use for secrets.</p>
   </div>
  </section>
  <section class="note route-guidance" aria-labelledby="route-guidance-title">
   <h2 id="route-guidance-title">How this specific conversion works</h2>
   <p data-route-use-case>{tool.useCase}</p>
   <h2>Download format</h2><p data-route-output>{tool.outputNotes}</p>
   <h2>Limitations to check</h2><p data-route-caveat>{tool.caveat}</p>
  </section>
  <section class="note"><h2>Limits and fidelity</h2>
   <table><caption>Practical constraints for this tool</caption><tbody>
    <tr><th scope="row">Input location</th><td>Your browser; no server upload</td></tr>
    <tr><th scope="row">Browser budget</th><td>16 MiB decoded text, 200,000 rows and 500 columns maximum</td></tr>
    <tr><th scope="row">Precision</th><td>Quoted IDs preserve leading zeros; JSON numeric values beyond JavaScript integer precision are not lossless</td></tr>
    <tr><th scope="row">Export safety</th><td>Formula-escape option is on by default for CSV/TSV; verify results in your spreadsheet program</td></tr>
   </tbody></table>
  </section>
  <section class="related"><h2>Related working tools</h2><ul>{related.map(t=><li><a href={'/tools/'+t.id+'/'}>{t.label}</a></li>)}</ul></section>
  <noscript><p class="warning">This data converter requires JavaScript. Its explanation, limits, and navigation remain readable without scripts.</p></noscript>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}/>
 </main>
 <script id="studio-example" type="application/json" set:html={JSON.stringify(sample)}/>
 <script type="module" src="/assets/studio-ui.mjs"></script>
</BaseLayout>
