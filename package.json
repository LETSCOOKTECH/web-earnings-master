{
  "name": "web-earnings-master",
  "version": "3.0.0-draft.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:skills": "node scripts/validate-skills.mjs",
    "audit:sources": "node scripts/check-sources.mjs",
    "audit:fixture": "node scripts/audit-static-site.mjs --dist tests/fixtures/site --origin https://fixture.example",
    "test": "node --test tests/*.test.mjs && npm run lint:skills && npm run audit:sources && npm run audit:fixture && npm run audit:evidence && npm run audit:adstxt && npm run audit:intents && npm run audit:robots && npm run audit:discovery",
    "audit:evidence": "node scripts/check-evidence.mjs --file templates/evidence-manifest.example.json",
    "audit:adstxt": "node scripts/audit-ads-txt.mjs --file tests/fixtures/ads.txt --seller google.com",
    "audit:intents": "node scripts/audit-page-intents.mjs --file templates/page-intents.example.json",
    "audit:robots": "node scripts/check-robots-policy.mjs --file tests/fixtures/robots-policy-valid.txt",
    "audit:links": "node scripts/verify-source-links.mjs --limit 12",
    "audit:foundation-sources": "node scripts/check-foundation-sources.mjs",
    "lab:ir": "node scripts/ir-reference-lab.mjs",
    "watch:sources": "node scripts/watch-official-updates.mjs",
    "audit:research": "node scripts/check-research-evidence.mjs",
    "lab:owned": "node --test tests/owned-web-lab.test.mjs",
    "lab:browsers": "node --test tests/browser-e2e.mjs",
    "gate:action-sources": "node scripts/require-action-time-sources.mjs",
    "audit:aeo": "node scripts/audit-answer-page.mjs --file templates/discovery/answer-page.example.json",
    "audit:aso:play": "node scripts/audit-aso-listing.mjs --file templates/discovery/google-play.example.json",
    "audit:aso:apple": "node scripts/audit-aso-listing.mjs --file templates/discovery/apple-app-store.example.json",
    "eval:geo": "node scripts/evaluate-ai-citations.mjs --file templates/discovery/ai-citation-batch.example.json",
    "test:discovery": "node --test tests/discovery-skills.test.mjs",
    "audit:discovery": "node scripts/check-discovery-evidence.mjs"
  },
  "description": "Source-governed Codex skills for web SEO, AEO, GEO/AI retrieval, Google Play/Apple ASO, AdSense and growth"
}
