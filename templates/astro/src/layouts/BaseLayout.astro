---
import SEOHead from '../components/SEOHead.astro';
interface Props {title: string; description: string; canonicalPath: string;}
const {title,description,canonicalPath} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead title={title} description={description} canonicalPath={canonicalPath} />
  </head>
  <body>
    <a href="#main">Skip to content</a>
    <header><nav aria-label="Main"><a href="/">Home</a><a href="/tools/image-resizer/">Image resizer</a></nav></header>
    <main id="main"><slot /></main>
    <footer><a href="/privacy/">Privacy</a><a href="/contact/">Contact</a></footer>
  </body>
</html>

