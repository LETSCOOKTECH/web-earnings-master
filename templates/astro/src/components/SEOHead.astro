---
// EXAMPLE scaffolding; verify actual HTML output and real origin before shipping.
interface Props { title: string; description: string; canonicalPath: string; image?: string; }
const {title,description,canonicalPath,image} = Astro.props;
if (!Astro.site) throw new Error('Astro.site is required for canonical URLs');
const site = Astro.site;
const canonical = new URL(canonicalPath,site).href;
const shareImage = image ? new URL(image,site).href : undefined;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{shareImage && <meta property="og:image" content={shareImage} />}

